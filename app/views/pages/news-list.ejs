<%- include('../partials/header') %>

<section class="section">
  <div class="section-head">
    <h2><%= title %></h2>
    <div class="tabs">
      <a href="/news" class="<%= cat === '' ? 'on' : '' %>">全部</a>
      <a href="/news?cat=article" class="<%= cat === 'article' ? 'on' : '' %>">技术文章</a>
      <% categories.forEach(function (c) { %>
        <a href="/news?cat=<%= c.b_id %>" class="<%= cat === String(c.b_id) ? 'on' : '' %>"><%= c.b_type %></a>
      <% }); %>
    </div>
  </div>

  <% if (!list.length) { %>
    <div class="empty">暂无内容</div>
  <% } else { %>
  <div class="list">
    <% list.forEach(function (n) { %>
      <div class="list-item" style="padding:14px 18px">
        <span class="dot"></span>
        <span class="t">
          <a href="/news/<%= n.n_id %>" style="font-size:15px"><%= n.n_title %></a>
          <span class="hint" style="margin-left:8px"><%= label[n.b_id] || '' %></span>
        </span>
        <span class="d"><%= h.fmtDate(n.n_data) %> · 阅读 <%= n.n_hit || 0 %></span>
      </div>
    <% }); %>
  </div>
  <%- include('../partials/pager', { pager: pager, base: '/news', params: { cat: cat } }) %>
  <% } %>
</section>

<%- include('../partials/footer') %>
