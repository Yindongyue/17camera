<%- include('../partials/header') %>

<section class="section">
  <div class="section-head">
    <h2>逸憩论坛</h2>
    <span class="more"><%= totalThreads %> 个主题 · <%= totalPosts %> 篇帖子</span>
  </div>
  <div class="grid grid-2">
    <% forums.forEach(function (f) { %>
      <div class="panel" style="padding:18px 20px">
        <h3 style="margin:0 0 6px;font-size:16px"><a href="/forum/<%= f.fid %>"><%= f.name %></a></h3>
        <p style="margin:0 0 10px;font-size:13px;color:#777;min-height:22px"><%= f.description || '' %></p>
        <div style="font-size:12.5px;color:#999">
          主题 <strong style="color:#333"><%= f.stats.threads %></strong> ·
          帖子 <strong style="color:#333"><%= f.stats.posts %></strong>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<%- include('../partials/footer') %>
