<%- include('../partials/header') %>

<section class="section" style="max-width:460px;margin:30px auto">
  <div class="panel">
    <h2 style="margin:0 0 18px;font-size:18px">会员登录</h2>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="form-row"><label>用户名</label><input name="username" required autofocus></div>
      <div class="form-row"><label>密码</label><input name="password" type="password" required></div>
      <button class="btn" type="submit" style="width:100%">登录</button>
    </form>
    <p class="hint" style="margin-top:14px">还没有账号？<a href="/register">立即注册</a></p>
  </div>
</section>

<%- include('../partials/footer') %>
